---
import loaderRaw from '../../public/loader/sousadev-loader.svg?raw';

/**
 * Full-screen brand loader shown once, on the first click of a "Request a
 * proposal" link in a browser session, before the page navigates to
 * /contact. Not shown on repeat visits within the same session, on a direct
 * visit to /contact, or under prefers-reduced-motion (the click listeners
 * below simply never attach for those users, so the SMIL animation never
 * starts).
 *
 * Rendered once in Base.astro; the inline script finds every proposal link on
 * whichever page it is placed on, so no other component needs to know about
 * it (src/components/Hero.astro, Nav.astro, CTABlock.astro, Blog.astro
 * and NotFound.astro all link to /contact and are covered automatically).
 */
---

<div class="page-loader" data-page-loader aria-hidden="true">
  <div class="page-loader__mark" set:html={loaderRaw} />
</div>

<style>
  .page-loader {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--ink);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity var(--dur-base) var(--ease-brand);
  }

  .page-loader.is-active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .page-loader__mark {
    width: 96px;
    height: 96px;
    --sd-loader-ink: var(--text-on-ink);
    --sd-loader-green: var(--green);
  }

  .page-loader__mark :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>

<script>
  // Progressive enhancement only: every link below is a real <a href> that
  // navigates normally if this script never runs.
  const overlay = document.querySelector<HTMLElement>('[data-page-loader]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (overlay && !reduceMotion) {
    const STORAGE_KEY = 'sd-loader-shown';
    // One loop of the loader's own 1.8s animation (see the SVG's dur="1.8s"),
    // so the transition never navigates away mid-cycle.
    const DURATION_MS = 1800;

    const alreadyShown = () => {
      try {
        return sessionStorage.getItem(STORAGE_KEY) === '1';
      } catch {
        // Storage unavailable (private mode, blocked cookies): treat as
        // already shown so navigation is never blocked by this feature.
        return true;
      }
    };

    if (!alreadyShown()) {
      const links = document.querySelectorAll<HTMLAnchorElement>('a[href="/contact"], a[href="/pt/contact"]');
      links.forEach((link) => {
        link.addEventListener('click', (event) => {
          if (
            event.defaultPrevented ||
            event.button !== 0 ||
            event.metaKey ||
            event.ctrlKey ||
            event.shiftKey ||
            event.altKey ||
            alreadyShown()
          ) {
            return;
          }
          event.preventDefault();
          try {
            sessionStorage.setItem(STORAGE_KEY, '1');
          } catch {
            // Ignore: the click still proceeds below either way.
          }
          overlay.classList.add('is-active');
          window.setTimeout(() => {
            window.location.href = link.href;
          }, DURATION_MS);
        });
      });
    }
  }
</script>
