---
import { LOCKUP_VIEWBOX, LOCKUP_RATIO, MARK_VIEWBOX, lockupMarkup, markMarkup } from '../lib/logo';

interface Props {
  /** Lockup height in px. 30 in the footer, 34 in the nav, per the reference. */
  height?: number;
  variant?: 'lockup' | 'mark';
  /**
   * Rotates the mark and exchanges the chevron colours when the parent link is
   * hovered or keyboard-focused (audit D04). Nav and footer only.
   */
  interactive?: boolean;
  class?: string;
}

const { height = 34, variant = 'lockup', interactive = false, class: className } = Astro.props;
const isLockup = variant === 'lockup';
const width = isLockup ? Math.round(height * LOCKUP_RATIO * 100) / 100 : height;
---

<svg
  class:list={['logo', { 'logo--interactive': interactive }, className]}
  viewBox={isLockup ? LOCKUP_VIEWBOX : MARK_VIEWBOX}
  width={width}
  height={height}
  role="presentation"
  aria-hidden="true"
  focusable="false"
  set:html={isLockup ? lockupMarkup : `<g class="lockup__mark">${markMarkup}</g>`}
/>

<style>
  .logo {
    --mark-s: var(--text-on-ink);
    --mark-d: var(--green);
    overflow: visible;
  }

  /*
   * Specified nav/footer hover (developer spec, audit D04): the mark rotates
   * 180deg and the S and D chevrons exchange colours, over .6s on the brand
   * easing. The mark occupies the 120-unit square at the origin of both the
   * lockup and mark viewBoxes, so it turns about (60, 60) and the separator
   * and wordmark stay put (audit D16).
   *
   * Everything is scoped to no-preference, so under prefers-reduced-motion the
   * mark stays static and keeps its canonical colours on hover and focus.
   */
  @media (prefers-reduced-motion: no-preference) {
    .logo--interactive :global(.lockup__mark) {
      transform-box: view-box;
      transform-origin: 60px 60px;
      transition: transform var(--dur-slow) var(--ease-brand);
    }

    .logo--interactive :global(.lockup__mark path) {
      transition: stroke var(--dur-slow) var(--ease-brand);
    }

    :global(a:hover) > .logo--interactive,
    :global(a:focus-visible) > .logo--interactive {
      --mark-s: var(--green);
      --mark-d: var(--paper);
    }

    :global(a:hover) > .logo--interactive :global(.lockup__mark),
    :global(a:focus-visible) > .logo--interactive :global(.lockup__mark) {
      transform: rotate(180deg);
    }
  }
</style>
