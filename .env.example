# Proposal form delivery. Set these in the host's environment, never in the repo
# (self-hosted: /etc/sousadev/proposal.env, read by deploy/sousadev-proposal.service).
# Without them the endpoint answers 503 and the form reports that nothing was sent.
RESEND_API_KEY=
PROPOSAL_TO=hello@sousadev.com
PROPOSAL_FROM=
