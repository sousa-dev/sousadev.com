# Proposal form delivery. Set these in the host's environment, never in the repo
# (self-hosted: /etc/sousadev/proposal.env, read by deploy/sousadev-proposal.service).
# Without them the endpoint answers 503 and the form reports that nothing was sent.
RESEND_API_KEY=
PROPOSAL_TO=hello@sousadev.com
PROPOSAL_FROM=

# Optional spam check (Cloudflare Turnstile, free: dash.cloudflare.com > Turnstile,
# add the sousadev.com hostname). Set both or neither.
# Site key is public and read at build time (.env in the repo checkout on the
# build machine). Secret key is server side only (proposal.env).
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional, comma separated. Defaults to sousadev.com,www.sousadev.com.
TURNSTILE_HOSTNAMES=
