{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*.ts", "**/*.astro", "scripts/**/*.mjs"],
  "exclude": ["dist", "node_modules", "lda", "assets", "vendor"],
  "compilerOptions": {
    "strictNullChecks": true,
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true
  }
}
