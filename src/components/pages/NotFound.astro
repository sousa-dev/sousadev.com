---
import Button from '../Button.astro';
import Eyebrow from '../Eyebrow.astro';
import { useTranslations, type Locale } from '../../lib/i18n';
import { NAV_KEYS, path } from '../../lib/routes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section class="notfound">
  <div class="texture"></div>
  <div class="container notfound__inner">
    <Eyebrow>{t.notFound.code}</Eyebrow>
    <h1>{t.notFound.title}</h1>
    <p class="lead">{t.notFound.sub}</p>
    <ul class="notfound__links">
      {NAV_KEYS.map((key) => <li><a href={path(locale, key)}>{t.nav[key]}</a></li>)}
      <li><a href={path(locale, 'blog')}>{t.nav.blog}</a></li>
      <li><a href={path(locale, 'contact')}>{t.contact.pageTitle}</a></li>
    </ul>
    <Button href={path(locale, 'home')} size="lg">{t.notFound.home}</Button>
  </div>
</section>

<style>
  .notfound { position: relative; overflow: hidden; }
  .notfound__inner {
    position: relative;
    padding-block: var(--s-10) var(--s-10);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s-5);
    min-height: 50vh;
  }
  .notfound__inner .lead { max-width: 560px; }
  .notfound__links {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-5);
    font-size: var(--text-ui);
  }
  .notfound__links a { color: var(--signal); }

  @media (max-width: 639px) {
    .notfound__inner { padding-block: var(--s-8); }
    .notfound__links { flex-direction: column; gap: var(--s-3); }
  }
</style>
